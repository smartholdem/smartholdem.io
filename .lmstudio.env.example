# Copy to .lmstudio.env (project root) or ~/.lmstudio.env used by `yarn news:translate`.
# LM Studio: load a model → Developer → Start Server + "Serve on Local Network".
LMSTUDIO_URL=http://localhost:1234
# Optional: exact model id from LM Studio (default: first loaded model)
# LMSTUDIO_MODEL=qwen3-14b
# 1 = append /no_think (Qwen3 thinking models), 0 = off
LMSTUDIO_NO_THINK=1
LMSTUDIO_TEMPERATURE=0.2
# Max chars of article HTML per request (lower for small context windows)
NEWS_TR_CHUNK=2800
# Parallel requests (1-8). In LM Studio set the same "Max Concurrent Predictions"
NEWS_TR_CONCURRENCY=3
